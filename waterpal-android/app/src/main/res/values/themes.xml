<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========== 清新天蓝主题（默认） ========== -->
    <style name="Theme.WaterPal.Coral" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#03A9F4</item>
        <item name="colorPrimaryDark">#0288D1</item>
        <item name="colorAccent">#38B2AC</item>
        <item name="android:statusBarColor">#0288D1</item>
        <item name="android:windowBackground">#F7F8FA</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <!-- ========== 清新青绿主题 ========== -->
    <style name="Theme.WaterPal.Mint" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#38B2AC</item>
        <item name="colorPrimaryDark">#2C9A94</item>
        <item name="colorAccent">#03A9F4</item>
        <item name="android:statusBarColor">#2C9A94</item>
        <item name="android:windowBackground">#F0FDFA</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <!-- ========== 深邃紫蓝主题 ========== -->
    <style name="Theme.WaterPal.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#6366F1</item>
        <item name="colorPrimaryDark">#4F46E5</item>
        <item name="colorAccent">#A78BFA</item>
        <item name="android:statusBarColor">#4F46E5</item>
        <item name="android:windowBackground">#F5F3FF</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <!-- 默认主题（清新天蓝） -->
    <style name="Theme.WaterPal" parent="Theme.WaterPal.Coral" />

    <!-- 底部导航样式 -->
    <style name="BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
    </style>

</resources>
